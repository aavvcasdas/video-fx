 "lines": [
  {
   "t0": 0.2,
   "t1": 3.1,
   "zh": "坏掉的脑子 啊疼不痛"
  },
  {
   "t0": 3.2,
   "t1": 5.7,
   "zh": "这雨下得不合时宜"
  },
  {
   "t0": 6.2,
   "t1": 8.6,
   "zh": "总会过分要命的闷"
  },
  {
   "t0": 8.7,
   "t1": 10.3,
   "zh": "在这个时候"
  },
  {
   "t0": 10.5,
   "t1": 13.8,
   "zh": "我都会想象的念头"
  },
  {
   "t0": 15.8,
   "t1": 18.2,
   "zh": "别怕你就算我是你的"
  },
  {
   "t0": 18.3,
   "t1": 20.3,
   "zh": "小小狗也总会被打痛"
  },
  {
   "t0": 20.5,
   "t1": 24.2,
   "zh": "意念中的开心 却总是被一次掏空"
  },
  {
   "t0": 24.4,
   "t1": 26.7,
   "zh": "在去年夏天跟你说了"
  },
  {
   "t0": 26.8,
   "t1": 28.3,
   "zh": "一个小小要求"
  },
  {
   "t0": 28.4,
   "t1": 32.3,
   "zh": "答应了不放手"
  },
  {
   "t0": 32.4,
   "t1": 33.8,
   "zh": "还记得"
  },
  {
   "t0": 35.8,
   "t1": 38.6,
   "zh": "这故事中的人不太精彩"
  },
  {
   "t0": 38.8,
   "t1": 40.6,
   "zh": "夏去了又回来"
  },
  {
   "t0": 40.8,
   "t1": 42.3,
   "zh": "而人却已不在"
  },
  {
   "t0": 43.2,
   "t1": 46.2,
   "zh": "它重复着我汹涌的忍耐"
  },
  {
   "t0": 46.4,
   "t1": 48.2,
   "zh": "我拿了总会还"
  },
  {
   "t0": 48.3,
   "t1": 50,
   "zh": "你拿了就逃开"
  },
  {
   "t0": 50.2,
   "t1": 54.2,
   "zh": "在失去中我慢慢的变呆"
  },
  {
   "t0": 54.4,
   "t1": 58.2,
   "zh": "是不同步的未来"
  },
  {
   "t0": 58.5,
   "t1": 62,
   "zh": "却把记忆中的日记更改"
  },
  {
   "t0": 62.3,
   "t1": 64,
   "zh": "把虚伪的尘埃"
  },
  {
   "t0": 64.2,
   "t1": 66.2,
   "zh": "也全部都掩盖"
  },
  {
   "t0": 66.5,
   "t1": 70,
   "zh": "把每次心痛 都当成活该"
  },
  {
   "t0": 70.4,
   "t1": 73.9,
   "zh": "把心慢慢的释怀"
  },
  {
   "t0": 74.2,
   "t1": 78,
   "zh": "我相信总有一天你会明白"
  }
 ]
}