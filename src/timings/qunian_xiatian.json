   "zh": "我都会想象的念头"
  },
  {
   "t0": 16.0,
   "t1": 18.0,
   "zh": "别怕你就算我是你的"
  },
  {
   "t0": 18.5,
   "t1": 20.66,
   "zh": "小小狗也总会被打痛"
  },
  {
   "t0": 20.66,
   "t1": 24.3,
   "zh": "意念中的开心 却总是被一次掏空"
  },
  {
   "t0": 24.5,
   "t1": 27.0,
   "zh": "在去年夏天跟你说了"
  },
  {
   "t0": 27.0,
   "t1": 29.5,
   "zh": "一个小小要求"
  },
  {
   "t0": 30.0,
   "t1": 31.0,
   "zh": "答应了不放手"
  },
  {
   "t0": 32.97,
   "t1": 34.01,
   "zh": "还记得"
  },
  {
   "t0": 35.5,
   "t1": 39.5,
   "zh": "这故事中的人不太精彩"
  },
  {
   "t0": 39.5,
   "t1": 41.0,
   "zh": "夏去了又回来"
  },
  {
   "t0": 42.0,
   "t1": 43.0,
   "zh": "而人却已不在"
  },
  {
   "t0": 43.0,
   "t1": 47.0,
   "zh": "它重复着我汹涌的忍耐"
  },
  {
   "t0": 47.0,
   "t1": 49.0,
   "zh": "我拿了总会还"
  },
  {
   "t0": 49.0,
   "t1": 51.0,
   "zh": "你拿了就逃开"
  },
  {
   "t0": 51.0,
   "t1": 55.0,
   "zh": "在失去中我慢慢的变呆"
  },
  {
   "t0": 55.0,
   "t1": 59.0,
   "zh": "是不同步的未来"
  },
  {
   "t0": 59.0,
   "t1": 62.5,
   "zh": "却把记忆中的日记更改"
  },
  {
   "t0": 62.5,
   "t1": 64.5,
   "zh": "把虚伪的尘埃"
  },
  {
   "t0": 64.5,
