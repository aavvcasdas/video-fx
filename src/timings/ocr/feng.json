  {
   "t0": 1.0,
   "t1": 11.0,
   "zh": "再爱我二遍"
  },
  {
   "t0": 12.0,
   "t1": 16.0,
   "zh": "十一月的爵邦"
  },
  {
   "t0": 18.0,
   "t1": 25.0,
   "zh": "乌云在我们心里搁下二块阴影"
  },
  {
   "t0": 26.0,
   "t1": 31.0,
   "zh": "我听沉寂已久的心情"
  },
  {
   "t0": 31.0,
   "t1": 38.0,
   "zh": "清晰透明就像美丽的风景"
  },
  {
   "t0": 38.0,
   "t1": 46.0,
   "zh": "总在回忆里才看的清"
  },
  {
   "t0": 46.0,
   "t1": 53.0,
   "zh": "被伤透的心能不能够继续爱我"
  },
  {
   "t0": 53.0,
   "t1": 60.0,
   "zh": "我用力牵起没温度的双手"
  },
  {
   "t0": 60.0,
   "t1": 67.0,
   "zh": "过往温柔已经被时间上锁"
  },
  {
   "t0": 67.0,
   "t1": 74.0,
   "zh": "只剩挥散不去的难过"
  },
  {
   "t0": 74.0,
   "t1": 79.0,
   "zh": "缓缓飘落的枫叶像思念"
  },
  {
   "t0": 80.0,
   "t1": 87.0,
   "zh": "我点燃烛火温暖岁末的秋天"
  },
  {
   "t0": 87.0,
   "t1": 90.0,
   "zh": "极光掠夺天边"
  },
  {
   "t0": 90.0,
   "t1": 95.0,
   "zh": "北风掠过想你的容颜"
  },
  {
   "t0": 95.0,
   "t1": 98.0,
   "zh": "我把爱烧成了落叶"
  },
  {
   "t0": 98.0,
   "t1": 103.0,
   "zh": "却换不回熟悉的那张脸"
  },
  {
   "t0": 103.0,
   "t1": 108.0,
   "zh": "缓缓飘落的枫叶像思念"
  },
  {
   "t0": 108.0,
   "t1": 115.0,
   "zh": "为何挽回要赶在冬天来之前"
  },
  {
   "t0": 116.0,
   "t1": 119.0,
   "zh": "爱你穿越时间"
  },
  {
   "t0": 119.0,
   "t1": 123.0,
   "zh": "两行来自秋末的眼泪"
  },
  {
   "t0": 123.0,
   "t1": 127.0,
   "zh": "让爱渗透了地面"
  },
  {
