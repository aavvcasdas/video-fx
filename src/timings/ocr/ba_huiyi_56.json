 "source": "mv/《把回忆拼好给你》.mp4",
 "lines": [
  {
   "t0": 1.5,
   "t1": 5.0,
   "zh": "我们都是真实存"
  },
  {
   "t0": 5.0,
   "t1": 9.0,
   "zh": "祈愿小世界里不只有"
  },
  {
   "t0": 9.0,
   "t1": 12.0,
   "zh": "直到遇见你我以为就光明起"
  },
  {
   "t0": 12.0,
   "t1": 14.0,
   "zh": "眼睛里看到的"
  },
  {
   "t0": 14.0,
   "t1": 16.0,
   "zh": "广无垠的大海"
  },
  {
   "t0": 16.0,
   "t1": 19.0,
   "zh": "有你在的日子里不可能被"
  },
  {
   "t0": 19.5,
   "t1": 23.0,
   "zh": "你陪着我发保在最灰暗的日子"
  },
  {
   "t0": 23.0,
   "t1": 25.5,
   "zh": "你让我学会如何拨开"
  },
  {
   "t0": 25.5,
   "t1": 27.5,
   "zh": "将快乐全部收集"
  },
  {
   "t0": 27.5,
   "t1": 32.0,
   "zh": "将不开心全都淘汰"
  },
  {
   "t0": 32.0,
   "t1": 36.0,
   "zh": "像转瞬即逝的烟花"
  },
  {
   "t0": 36.0,
   "t1": 38.5,
   "zh": "只停在绽放一种"
  },
  {
   "t0": 38.5,
   "t1": 39.5,
   "zh": "一制那"
  },
  {
   "t0": 39.5,
   "t1": 42.0,
   "zh": "我却已无法自"
  },
  {
   "t0": 42.0,
   "t1": 43.0,
   "zh": "已无法自拔"
  },
  {
   "t0": 43.0,
   "t1": 44.0,
   "zh": "我们的"
  },
  {
   "t0": 44.0,
   "t1": 45.0,
   "zh": "我们的爱总有"
  },
  {
   "t0": 45.0,
   "t1": 47.5,
   "zh": "也为你骗自己"
  },
  {
   "t0": 47.5,
   "t1": 49.5,
   "zh": "也为你骗自己放"
  },
  {
   "t0": 49.5,
   "t1": 54.0,
   "zh": "却忘了爱自己"
  },
  {
   "t0": 54.5,
   "t1": 56.0,
   "zh": "把回忆拼好给你"
  }
 ]
}