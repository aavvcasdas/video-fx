 "method": "legacy-handwritten",
 "note": "mv_pack_short.js",
 "lines": [
  {
   "t0": 1,
   "t1": 5.2,
   "zh": "我们都是天真 真实存在的"
  },
  {
   "t0": 5.3,
   "t1": 8.2,
   "zh": "祈愿小世界里不只有我"
  },
  {
   "t0": 8.3,
   "t1": 12.2,
   "zh": "直到遇见你 我以为就光明起来"
  },
  {
   "t0": 12.3,
   "t1": 16,
   "zh": "眼睛里看到的都是 广袤无垠的大海"
  },
  {
   "t0": 16.1,
   "t1": 19.2,
   "zh": "有你在的日子里不可能被击败"
  },
  {
   "t0": 19.3,
   "t1": 23,
   "zh": "在最难熬的日子 你陪着我"
  },
  {
   "t0": 23.1,
   "t1": 25.2,
   "zh": "你让我学会如何拨开阴霾"
  },
  {
   "t0": 25.3,
   "t1": 27.2,
   "zh": "将快乐全部留下来"
  },
  {
   "t0": 27.3,
   "t1": 29.2,
   "zh": "将不开心全都抛开"
  },
  {
   "t0": 29.3,
   "t1": 32.1,
   "zh": "你对我说的情话"
  },
  {
   "t0": 32.2,
   "t1": 35.8,
   "zh": "像转瞬即逝的烟花"
  },
  {
   "t0": 35.9,
   "t1": 39.2,
   "zh": "只停在绚烂的一刹那"
  },
  {
   "t0": 39.3,
   "t1": 42.2,
   "zh": "我却已无法自拔"
  },
  {
   "t0": 42.3,
   "t1": 45.2,
   "zh": "我们的爱总有时差"
  },
  {
   "t0": 45.3,
   "t1": 49,
   "zh": "也为你骗自己放下"
  },
  {
   "t0": 49.1,
   "t1": 54,
   "zh": "爱炙热的你 却忘了爱自己"
  },
  {
   "t0": 54.1,
   "t1": 56.03,
   "zh": "把回忆拼好给你"
  }
 ]
}