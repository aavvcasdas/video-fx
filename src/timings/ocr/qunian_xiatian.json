 "source": "去年夏天.mp4",
 "lines": [
  {
   "t0": 1.0,
   "t1": 3.0,
   "zh": "啊疼不疼痛不痛"
  },
  {
   "t0": 3.0,
   "t1": 5.0,
   "zh": "这样一"
  },
  {
   "t0": 5.0,
   "t1": 7.0,
   "zh": "幻想中我的梦"
  },
  {
   "t0": 7.0,
   "t1": 9.0,
   "zh": "总会过分要命的"
  },
  {
   "t0": 9.0,
   "t1": 11.0,
   "zh": "在过去每"
  },
  {
   "t0": 11.0,
   "t1": 16.0,
   "zh": "我都会想象的念头"
  },
  {
   "t0": 16.0,
   "t1": 18.0,
   "zh": "你就算我是你的"
  },
  {
   "t0": 18.5,
   "t1": 21.0,
   "zh": "小小狗也总"
  },
  {
   "t0": 21.0,
   "t1": 22.5,
   "zh": "意念中想不痛"
  },
  {
   "t0": 22.5,
   "t1": 24.0,
   "zh": "却总是杭"
  },
  {
   "t0": 24.5,
   "t1": 27.0,
   "zh": "欢水在去年夏天跟你说了"
  },
  {
   "t0": 27.0,
   "t1": 29.5,
   "zh": "一个小小要求"
  },
  {
   "t0": 30.0,
   "t1": 31.0,
   "zh": "浴应了不放手"
  },
  {
   "t0": 32.0,
   "t1": 33.0,
   "zh": "冷应了不放手"
  },
  {
   "t0": 33.0,
   "t1": 35.5,
   "zh": "还有什么悲哀"
  },
  {
   "t0": 35.5,
   "t1": 39.5,
   "zh": "这故事中的"
  },
  {
   "t0": 39.5,
   "t1": 41.0,
   "zh": "夏去了又回来"
  },
  {
   "t0": 41.0,
   "t1": 42.0,
   "zh": "而人却"
  },
  {
   "t0": 42.0,
   "t1": 43.0,
   "zh": "而久却已不在"
  },
  {
   "t0": 43.0,
   "t1": 47.0,
   "zh": "它重复着我"
  },
  {
   "t0": 47.0,
   "t1": 49.0,
   "zh": "我拿了总会还"
  },
  {
   "t0": 49.0,
   "t1": 51.0,
   "zh": "你拿了就逃开"
  },
  {
   "t0": 51.0,
   "t1": 55.0,
   "zh": "在失去中我慢慢的变呆"
  },
  {
   "t0": 55.0,
   "t1": 59.0,
   "zh": "是不同步"
  },
  {
   "t0": 59.0,
   "t1": 62.5,
   "zh": "却把书色中的日记更改"
  },
  {
   "t0": 62.5,
   "t1": 64.5,
   "zh": "把虚伪的尘埃"
  },
  {
   "t0": 64.5,
   "t1": 66.0,
   "zh": "也全部都掩盖"
  },
  {
   "t0": 66.5,
   "t1": 71.0,
   "zh": "把每次心痛"
  },
  {
   "t0": 71.0,
   "t1": 74.5,
   "zh": "把心慢慢的释怀"
  },
  {
   "t0": 74.5,
   "t1": 78.0,
   "zh": "我相信总有"
  }
 ]
}