  {
   "t0": 0.4,
   "t1": 4.8,
   "zh": "I miss you"
  },
  {
   "t0": 4.9,
   "t1": 7.8,
   "zh": "Now"
  },
  {
   "t0": 8.8,
   "t1": 11.8,
   "zh": "don't you love me"
  },
  {
   "t0": 12.8,
   "t1": 19.8,
   "zh": "Sorry I'm so sorry"
  },
  {
   "t0": 20.8,
   "t1": 22.8,
   "zh": "那时我放开了的手"
  },
  {
   "t0": 22.9,
   "t1": 24.8,
   "zh": "转过身只剩了保重"
  },
  {
   "t0": 24.9,
   "t1": 27.8,
   "zh": "你话都没说却哭了很久很久"
  },
  {
   "t0": 28.8,
   "t1": 29.8,
   "zh": "我喜欢坏坏的女友"
  },
  {
   "t0": 29.9,
   "t1": 31.8,
   "zh": "我喜欢刺激的感受"
  },
  {
   "t0": 31.9,
   "t1": 35.8,
   "zh": "你单纯太过多余了那些温柔"
  },
  {
   "t0": 35.9,
   "t1": 37.8,
   "zh": "你消失在无名大街"
  },
  {
   "t0": 37.9,
   "t1": 39.8,
   "zh": "从此就没有再见面"
  },
  {
   "t0": 39.9,
   "t1": 43.8,
   "zh": "好长的时间再没有你的来电"
  },
  {
   "t0": 43.9,
